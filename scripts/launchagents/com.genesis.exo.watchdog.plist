<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.genesis.exo.watchdog</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/jeremyserna/truth_forge/scripts/exo_watchdog.sh</string>
        <string>--recover</string>
    </array>

    <!-- Run every 60 seconds -->
    <key>StartInterval</key>
    <integer>60</integer>

    <!-- Also run at load (check immediately on login) -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/exo_watchdog_stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/exo_watchdog_stderr.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/jeremyserna/truth_forge/scripts</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/jeremyserna</string>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/jeremyserna/miniforge3/envs/exo/bin</string>
    </dict>
</dict>
</plist>
