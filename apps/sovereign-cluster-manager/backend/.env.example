# Sovereign Cluster Manager Configuration
# Copy to .env and fill in your values

# Supabase (required)
SCM_SUPABASE_URL=https://your-project.supabase.co
SCM_SUPABASE_KEY=your-anon-or-service-key

# EXO API (default: localhost)
SCM_EXO_API_URL=http://localhost:52415

# Vault path (your 8TB external)
SCM_VAULT_PATH=/Volumes/Vault/models

# This node's ID
SCM_NODE_ID=king

# Polling intervals (seconds)
SCM_POLL_INTERVAL_SECONDS=5.0
SCM_COMMAND_CHECK_INTERVAL_SECONDS=1.0

# Soldier hostnames (comma-separated in env, list in code)
SCM_SOLDIER_HOSTS=["soldier1.local", "soldier2.local", "soldier3.local"]
